# ===== LLM API Router 环境变量示例 =====
# 用法：cp .env.example .env，然后填写真实值。
# .env 已被 .gitignore 忽略，不会提交到仓库，请勿把真实密钥写进 docker-compose.yml 或提交。

# JWT 签名密钥（生产必填，长度须 >= 16）
# 生成：openssl rand -hex 32
LLM_ROUTER_JWT_SECRET=

# 敏感数据加密密钥（建议生产必填）：用户私有路由 API Key 用 Fernet 加密存储
# 生成：openssl rand -base64 32
# 注意：该密钥不可恢复，丢失后已加密的存量 API Key 无法解密，请务必备份。
ROUTER_DATA_KEY=

# 访问 Token 有效天数（可选，正整数，默认 7）
LLM_ROUTER_ACCESS_TOKEN_EXPIRE_DAYS=

# 管理员用户名（可选）：设置后该用户自动获得 admin 角色；未设置时系统首个注册用户为管理员
LLM_ROUTER_ADMIN_USERNAME=
